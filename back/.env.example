# --- 앱 ---
DEBUG=false
LOG_LEVEL=INFO
# 리스트 값은 JSON 배열로 기입한다 (pydantic-settings가 JSON으로 파싱).
CORS_ORIGINS=["http://localhost:3000"]

# --- DB ---
# 로컬 개발: SQLite(비동기 드라이버 aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./stock.db
# 운영(Postgres): uv sync --extra postgres 후 아래로 교체
# DATABASE_URL=postgresql+asyncpg://stock:stock@localhost:5432/stock
DB_ECHO=false
# 운영에서는 false로 두고 alembic 마이그레이션을 사용한다.
DB_CREATE_ALL_ON_STARTUP=true

# --- 외부 HTTP (KRX / KIND) ---
HTTP_TIMEOUT_SECONDS=20

# --- 상장사 목록 ---
LISTED_COMPANY_MIN_COUNT=100
SUGGESTION_CANDIDATE_LIMIT=500

# --- LLM (Claude) ---
# 비워두면 SDK가 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / `ant auth login` 프로필을 찾는다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# 거절(refusal) 시 서버 측 대체 모델로 재실행. 베타 기능이라 조직별로 다르다 —
# 400이 발생하면 false로 두면 되고, 그래도 앱은 규칙 기반 판단으로 폴백한다.
LLM_SERVER_SIDE_FALLBACK=true
