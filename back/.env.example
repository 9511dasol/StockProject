# --- 앱 ---
DEBUG=false
LOG_LEVEL=INFO
# 리스트 값은 JSON 배열로 기입한다 (pydantic-settings가 JSON으로 파싱).
CORS_ORIGINS=["http://localhost:3000"]

# --- DB ---
# 로컬 개발: SQLite(비동기 드라이버 aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./stock.db
# 운영(Postgres): uv sync --extra postgres 후 아래로 교체
# DATABASE_URL=postgresql+asyncpg://stock:stock@localhost:5432/stock
#
# Supabase 를 쓸 때는 대시보드 > Project Settings > Database > Connection string 의
# URI 를 **그대로** 붙여넣는다 (sslmode·postgres:// 접두는 앱이 정규화한다).
#
#   ⚠ "Direct connection"(db.<ref>.supabase.co:5432)은 최신 프로젝트에 없다.
#     그 호스트는 DNS 조차 해석되지 않으므로 반드시 아래 둘 중 하나를 쓴다.
#
#   Transaction pooler (6543) — 서버리스·짧은 요청에 권장. 프리페어드는 앱이 끈다
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Session pooler (5432)     — 긴 트랜잭션·마이그레이션에 안전
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_ECHO=false
# 운영에서는 false로 두고 alembic 마이그레이션을 사용한다.
DB_CREATE_ALL_ON_STARTUP=true

# --- 외부 HTTP (KRX / KIND) ---
HTTP_TIMEOUT_SECONDS=20

# --- 상장사 목록 ---
LISTED_COMPANY_MIN_COUNT=100
SUGGESTION_CANDIDATE_LIMIT=500

# --- 재무·밸류에이션 ---
# 종목당 캐시 수명(초). 미스 한 번이 1~2초라 요청마다 조회할 수 없고,
# PER/PBR 은 주가를 따라 움직여 하루 캐시도 곤란하다.
STOCK_FUNDAMENTALS_TTL_SECONDS=900
STOCK_FUNDAMENTALS_CACHE_SIZE=512

# --- AI 판단 캐시·상한·자물쇠 ---
# 이 프로젝트에서 유일하게 돈이 나가는 경로(종목당 LLM 4회)의 수도꼭지다.
# 이 시간 안에는 같은 종목을 다시 물어도 뉴스 조회조차 없이 캐시를 낸다.
# 만료 뒤에는 뉴스 지문만 비교해, 기사가 그대로면 LLM 없이 수명을 연장한다.
ADVICE_CACHE_TTL_SECONDS=600
ADVICE_CACHE_SIZE=256
# 동시에 돌릴 수 있는 분석 수. 초과 요청은 429다(대기가 아니라 거절).
ADVICE_MAX_CONCURRENT=4
# AI 판단 엔드포인트 2개를 여는 공유 비밀키. 프런트 BFF 만 알고 브라우저에는 안 나간다.
# 프런트의 front/.env.local 에 ADVICE_API_KEY 로 **같은 값**을 넣어야 한다.
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 비워 두면 인증이 꺼지고(로컬 개발용) 기동 시 경고가 뜬다 — 외부에 노출할 때는 반드시 채운다.
ADVICE_API_KEY=

# --- LLM (OpenAI) ---
# 비워두면 SDK가 OPENAI_API_KEY 환경 변수를 읽는다.
OPENAI_API_KEY=
# 추론 강도(LLM_EFFORT)를 쓰므로 gpt-5 계열 또는 o 시리즈여야 한다.
OPENAI_MODEL=gpt-5.4
# 추론 토큰도 이 상한을 함께 쓴다. 낮추면 본문이 빈 채로 incomplete 가 될 수 있다.
LLM_MAX_TOKENS=16000
# none | minimal | low | medium | high | xhigh | max  (앱은 low 이상만 허용)
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# --- RAG (검색 증강 · Supabase pgvector) ---
# **대개 비워 둔다.** DATABASE_URL 이 Postgres 면 그것을 그대로 벡터 저장소로 쓴다 —
# 같은 Supabase 인스턴스가 앱 테이블과 pgvector 테이블을 함께 담는다. 두 곳에 같은
# 주소를 적어 두면 한쪽만 바꿔 어긋난다.
#
# 채우는 경우는 하나: **벡터만 다른 인스턴스로 빼고 싶을 때.** 있으면 이쪽이 이긴다.
# DATABASE_URL 이 SQLite 이고 이 값도 비어 있으면 RAG 만 꺼지고 나머지는 그대로 동작한다.
# 최초 1회 `uv run python -m scripts.verify_rag` 가 확장·테이블·인덱스까지 만든다.
VECTOR_DATABASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# 테이블의 vector(N) 이 이 값으로 만들어진다. 적재 후 바꾸면 차원이 어긋난다.
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=150
# 검색기별 후보 수 → 융합 후 상위 몇 건을 프롬프트에 넣을지
RAG_CANDIDATE_K=24
RAG_TOP_K=6
# 이보다 오래된 문서는 검색하지 않는다.
RAG_RECENCY_DAYS=120
# 판단 요청 때 새 뉴스를 색인할지. 끄면 스크립트·배치로만 채운다.
RAG_INGEST_ON_ADVICE=true
# 색인+검색 전체 예산(초). 넘기면 문서 없이 판단을 진행한다.
RAG_TIMEOUT_SECONDS=15

# --- 시가총액 배치 (자동완성 랭킹 가중치) ---
# 1차 소스 pykrx 는 KRX 데이터포털 로그인을 요구한다. 아래를 채우면 전 종목을
# 한 번에 받아온다. 비워두면 yfinance 폴백(종목당 1회 호출)으로 내려간다.
KRX_ID=
KRX_PW=
# yfinance 폴백이 1회 실행에서 채우는 종목 수 상한.
MARKET_CAP_BATCH_LIMIT=400
