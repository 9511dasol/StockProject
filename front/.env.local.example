# 백엔드 주소. **`/api/v1` 까지 포함한다** — 서비스 코드는 "/stocks/history" 처럼
# prefix 없는 경로만 넘긴다.
#
# 포트는 8000 이 표준이다 (back/README · uv run fastapi dev 기본값).
# 다른 포트로 띄웠다면 여기도 같이 바꿔야 한다 — 어긋나면 종목 상세가
# network_error 로 떨어진다.
STOCK_API_BASE_URL=http://localhost:8000/api/v1

# 1 이면 백엔드 없이 목 데이터로 화면을 그린다. 평소에는 비워 둔다.
USE_MOCK=

# 조회 타임아웃(ms). 생략하면 각각 20초 / 300초.
# STOCK_API_TIMEOUT_MS=20000
# STOCK_AI_TIMEOUT_MS=300000

# AI 판단 엔드포인트를 여는 공유 비밀키. back/.env 의 ADVICE_API_KEY 와 **같은 값**이어야 한다.
# BFF 라우트(app/api/stocks/advice)만 읽고 브라우저에는 나가지 않는다.
# NEXT_PUBLIC_ 을 붙이면 클라이언트 번들에 인라인되어 자물쇠가 무의미해진다 — 절대 붙이지 말 것.
# 양쪽 다 비워 두면 인증이 꺼진다 (로컬 개발 기본값).
ADVICE_API_KEY=

# --- 로그인 (NextAuth v5 / Auth.js) ---
#
# **전부 비워 두면 로그인이 꺼진다.** 그때도 서비스는 다 쓸 수 있고, 관심종목은
# 익명 신원(httpOnly 쿠키)으로 동작한다. 로그인 버튼과 /login 폼은 나타나지 않는다 —
# 누르면 깨지는 버튼을 두지 않기 위해서다.
#
# 키를 넣으면 코드를 고치지 않아도 그 수단이 켜진다.

# 세션 서명 키. 로컬 개발용 아무 값이나 넣으면 되고, 배포에서는 별도로 생성해 주입한다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# 호스트 검사를 건너뛴다. **리버스 프록시 뒤나 비표준 포트에서 필요하다.**
# NextAuth v5 는 프로덕션 빌드에서 요청 호스트를 검사하는데, 프록시를 거치면 실제
# 도메인과 달라져 `/api/auth/*` 가 전부 500(UntrustedHost)이 된다 — 화면은 멀쩡한데
# 로그인만 안 되는 상태라 원인을 찾기 어렵다. Vercel 은 자동으로 처리하므로 불필요.
AUTH_TRUST_HOST=true

# 사용자·세션·매직링크 토큰이 저장될 Postgres.
# 비워 두면 back/.env 의 DATABASE_URL 과 같은 값을 쓴다고 보면 되는데, 프런트는 그
# 파일을 못 읽으므로 **여기에도 적어야 한다.** 같은 Supabase 를 가리킨다.
# `postgresql+asyncpg://` 로 적어도 앱이 `postgresql://` 로 바꿔 준다 (lib/auth/pool.ts).
AUTH_DATABASE_URL=

# 구글 OAuth — https://console.cloud.google.com/apis/credentials
#   1. 사용자 인증 정보 만들기 > OAuth 클라이언트 ID > 웹 애플리케이션
#   2. 승인된 리디렉션 URI 에 아래를 등록한다 (배포 시 도메인도 함께)
#        http://localhost:3000/api/auth/callback/google
#   3. 발급된 클라이언트 ID / 보안 비밀번호를 여기 넣는다
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 이메일 매직링크 — SMTP URL 과 보내는 주소.
# Resend 예: smtp://resend:<API_KEY>@smtp.resend.com:587
# Gmail 앱 비밀번호 예: smtp://<계정>@gmail.com:<앱비밀번호>@smtp.gmail.com:587
# EMAIL_FROM 은 그 도메인에서 발송이 허용된 주소여야 한다 (아니면 스팸 처리된다).
EMAIL_SERVER=
EMAIL_FROM=
